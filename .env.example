# Environment configuration template for AdEzy
# Copy this to your Vercel Project Settings -> Environment Variables

# Supabase API Configuration
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
SUPABASE_JWKS_URL=https://xxxxxxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# Database Configuration (Supabase PostgreSQL)
USE_SUPABASE=True
USE_SQLITE=False
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xxxxxxxx
SUPABASE_DB_PASSWORD=your_supabase_password_here
SUPABASE_DB_PORT=6543

# AI Services (OpenRouter / ByteDance / Gemini)
SEEDREAM_API_KEY=your_api_key_here
SEEDREAM_API_BASE=https://openrouter.ai/api/v1
GEMINI_API_KEY=your_api_key_here
GEMINI_API_BASE=https://openrouter.ai/api/v1

# Security & Hosts
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,*
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.vercel.app
